{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MapEditorToolkit",
  "version": "0.1.0",
  "identifier": "MapEditorToolkit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Map Editor Toolkit",
        "width": 1000,
        "minWidth": 1000,
        "height": 600,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "closable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
        "data"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
